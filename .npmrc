# Hoist Prisma packages so that @prisma/client can find the generated .prisma/client
# types in node_modules/.prisma/client — required for IDE type resolution with pnpm.
# See: https://www.prisma.io/docs/guides/other/troubleshooting-orm/help-articles/nextjs-prisma-client-dev-practices
public-hoist-pattern[]=*prisma*
public-hoist-pattern[]=@prisma*
