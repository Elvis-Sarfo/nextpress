generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  email String @db.VarChar(255) @unique
  name String? @db.VarChar(255)
  active Boolean @default(true)
  passwordHash String? @db.VarChar(255)
  loginAttempts Int @default(0)
  lockedUntil DateTime?
  roles Roles[]
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  posts Posts[]
  comments Comments[]
  @@index([status])
  @@map("users")
}

model Roles {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name String @db.VarChar(255) @unique
  displayName String @db.VarChar(255)
  description String? @db.VarChar(255)
  permissions Permissions[]
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  users Users[]
  @@index([status])
  @@map("roles")
}

model Permissions {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name String @db.VarChar(255) @unique
  resource String @db.VarChar(100)
  action String @db.VarChar(100)
  scope String @db.VarChar(100) @default("all")
  description String? @db.VarChar(255)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  roles Roles[]
  @@index([status])
  @@map("permissions")
}

model Media {
  id String @id @default(uuid())
  documentId String
  status String @db.VarChar(20)
  filename String @db.VarChar(255)
  originalFilename String? @db.VarChar(255)
  url String @db.VarChar(255)
  mimeType String @db.VarChar(255)
  kind String @db.VarChar(100)
  extension String? @db.VarChar(255)
  size Int
  width Int?
  height Int?
  storageProvider String @db.VarChar(100)
  storageKey String @db.VarChar(255)
  altText String? @db.VarChar(255)
  title String? @db.VarChar(255)
  description String? @db.VarChar(255)
  uploadedAt DateTime
  metadata Json?
  filesize Int?
  alt String? @db.VarChar(255)
  caption String? @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  pages Pages[]
  posts Posts[]
  @@index([status])
  @@unique([documentId, status])
  @@index([documentId])
  @@map("media")
}

model MediaVersion {
  id String @id @default(uuid())
  documentId String
  version Int
  data Json
  createdAt DateTime @default(now())
  createdBy String @db.VarChar(255)
  @@unique([documentId, version])
  @@index([documentId])
  @@map("media_version")
}

model Pages {
  id String @id @default(uuid())
  documentId String
  title Json
  slug Json
  excerpt Json?
  sections Json?
  config Json?
  parentId String? @db.VarChar(255)
  order Int @default(0)
  status String @db.VarChar(100) @default("draft")
  featuredImageId String? @db.VarChar(255)
  seo Json?
  featuredImage Media? @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  pagesLocale PagesLocale[]
  @@index([status])
  @@unique([documentId, status])
  @@index([documentId])
  @@map("pages")
}

model PagesLocale {
  id String @id @default(uuid())
  pagesId String
  locale String @db.VarChar(10)
  title Json?
  slug Json?
  excerpt Json?
  Pages Pages @relation(fields: [pagesId], references: [id], onDelete: Cascade)
  @@unique([pagesId, locale])
  @@unique([locale, slug])
  @@index([locale])
  @@map("pages_locale")
}

model PagesVersion {
  id String @id @default(uuid())
  documentId String
  version Int
  data Json
  createdAt DateTime @default(now())
  createdBy String @db.VarChar(255)
  @@unique([documentId, version])
  @@index([documentId])
  @@map("pages_version")
}

model Blocks {
  id String @id @default(uuid())
  name String @db.VarChar(255) @unique
  type String @db.VarChar(100)
  templateName String? @db.VarChar(255)
  contentDefinition Json?
  dataSource Json?
  content Json?
  status String @db.VarChar(100) @default("draft")
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  blocksLocale BlocksLocale[]
  @@index([status])
  @@map("blocks")
}

model BlocksLocale {
  id String @id @default(uuid())
  blocksId String
  locale String @db.VarChar(10)
  content Json?
  Blocks Blocks @relation(fields: [blocksId], references: [id], onDelete: Cascade)
  @@unique([blocksId, locale])
  @@index([locale])
  @@map("blocks_locale")
}

model Menus {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name String @db.VarChar(255)
  location String? @db.VarChar(100)
  items Json?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("menus")
}

model Categories {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name String @db.VarChar(255) @unique
  slug Json
  description Json?
  color String? @db.VarChar(255)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  categoriesLocale CategoriesLocale[]
  posts Posts[]
  @@index([status])
  @@map("categories")
}

model CategoriesLocale {
  id String @id @default(uuid())
  categoriesId String
  locale String @db.VarChar(10)
  slug Json?
  description Json?
  Categories Categories @relation(fields: [categoriesId], references: [id], onDelete: Cascade)
  @@unique([categoriesId, locale])
  @@unique([locale, slug])
  @@index([locale])
  @@map("categories_locale")
}

model Posts {
  id String @id @default(uuid())
  documentId String
  title Json
  slug Json
  excerpt Json?
  content Json?
  categoryId String? @db.VarChar(100)
  featuredImageId String? @db.VarChar(255)
  authorId String? @db.VarChar(100)
  tags Json?
  publishedAt DateTime?
  status String @db.VarChar(100) @default("draft")
  seo Json?
  category Categories? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredImage Media? @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  author Users? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  postsLocale PostsLocale[]
  @@index([status])
  @@unique([documentId, status])
  @@index([documentId])
  @@map("posts")
}

model PostsLocale {
  id String @id @default(uuid())
  postsId String
  locale String @db.VarChar(10)
  title Json?
  slug Json?
  excerpt Json?
  content Json?
  Posts Posts @relation(fields: [postsId], references: [id], onDelete: Cascade)
  @@unique([postsId, locale])
  @@unique([locale, slug])
  @@index([locale])
  @@map("posts_locale")
}

model PostsVersion {
  id String @id @default(uuid())
  documentId String
  version Int
  data Json
  createdAt DateTime @default(now())
  createdBy String @db.VarChar(255)
  @@unique([documentId, version])
  @@index([documentId])
  @@map("posts_version")
}

model Comments {
  id String @id @default(uuid())
  content String @db.Text
  authorName String? @db.VarChar(255)
  authorEmail String? @db.VarChar(255)
  authorId String? @db.VarChar(100)
  contentType String @db.VarChar(100)
  contentId String @db.VarChar(255)
  parentId String? @db.VarChar(255)
  status String @db.VarChar(100) @default("pending")
  author Users? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("comments")
}

model Settings {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  siteName String @db.VarChar(255) @default("AGBON")
  logo Json?
  contact Json?
  headerNavigation Json?
  footer Json?
  socialMedia Json?
  newsletter Json?
  legal Json?
  features Json?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("settings")
}

