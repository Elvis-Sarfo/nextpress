generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Users {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  email String @db.VarChar(255) @unique
  name String? @db.VarChar(255)
  active Boolean @default(true)
  passwordHash String? @db.VarChar(255)
  loginAttempts Int @default(0)
  lockedUntil DateTime?
  roles Roles[]
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  posts Posts[]
  comments Comments[]
  contactMessages ContactMessages[]
  @@index([status])
  @@map("users")
}

model Roles {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name String @db.VarChar(255) @unique
  displayName String @db.VarChar(255)
  description String? @db.VarChar(255)
  permissions Permissions[]
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  users Users[]
  @@index([status])
  @@map("roles")
}

model Permissions {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name String @db.VarChar(255) @unique
  resource String @db.VarChar(100)
  action String @db.VarChar(100)
  scope String @db.VarChar(100) @default("all")
  description String? @db.VarChar(255)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  roles Roles[]
  @@index([status])
  @@map("permissions")
}

model Media {
  id String @id @default(uuid())
  documentId String
  status String @db.VarChar(20)
  filename String @db.VarChar(255)
  originalFilename String? @db.VarChar(255)
  url String @db.VarChar(255)
  mimeType String @db.VarChar(255)
  kind String @db.VarChar(100)
  extension String? @db.VarChar(255)
  size Int
  width Int?
  height Int?
  storageProvider String @db.VarChar(100)
  storageKey String @db.VarChar(255)
  altText String? @db.VarChar(255)
  title String? @db.VarChar(255)
  description String? @db.VarChar(255)
  uploadedAt DateTime
  metadata Json?
  filesize Int?
  alt String? @db.VarChar(255)
  caption String? @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  pages Pages[]
  posts Posts[]
  countries Countries[]
  productCategories ProductCategories[]
  @@index([status])
  @@unique([documentId, status])
  @@index([documentId])
  @@map("media")
}

model MediaVersion {
  id String @id @default(uuid())
  documentId String
  version Int
  data Json
  createdAt DateTime @default(now())
  createdBy String @db.VarChar(255)
  @@unique([documentId, version])
  @@index([documentId])
  @@map("media_version")
}

model Pages {
  id String @id @default(uuid())
  documentId String
  title Json
  slug Json
  excerpt Json?
  subtitle String? @db.VarChar(255)
  sections Json?
  config Json?
  parentId String? @db.VarChar(255)
  order Int @default(0)
  status String @db.VarChar(100) @default("draft")
  isIndexPage Boolean @default(false)
  featuredImageId String? @db.VarChar(255)
  seo Json?
  featuredImage Media? @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@unique([documentId, status])
  @@index([documentId])
  @@map("pages")
}

model PagesVersion {
  id String @id @default(uuid())
  documentId String
  version Int
  data Json
  createdAt DateTime @default(now())
  createdBy String @db.VarChar(255)
  @@unique([documentId, version])
  @@index([documentId])
  @@map("pages_version")
}

model Blocks {
  id String @id @default(uuid())
  name String @db.VarChar(255) @unique
  label String @db.VarChar(255)
  templateName String? @db.VarChar(255)
  contentDefinition Json?
  dataSource Json?
  content Json?
  status String @db.VarChar(100) @default("draft")
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("blocks")
}

model Menus {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name String @db.VarChar(255)
  location String? @db.VarChar(100)
  items Json?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("menus")
}

model Categories {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name String @db.VarChar(255) @unique
  slug Json
  description Json?
  color String? @db.VarChar(255)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  posts Posts[]
  @@index([status])
  @@map("categories")
}

model Posts {
  id String @id @default(uuid())
  documentId String
  title Json
  slug Json?
  excerpt Json?
  content Json?
  categoryId String? @db.VarChar(100)
  featuredImageId String? @db.VarChar(255)
  authorId String? @db.VarChar(100)
  tags Json?
  publishedAt DateTime?
  status String @db.VarChar(100) @default("draft")
  seo Json?
  category Categories? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  featuredImage Media? @relation(fields: [featuredImageId], references: [id], onDelete: SetNull)
  author Users? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@unique([documentId, status])
  @@index([documentId])
  @@map("posts")
}

model PostsVersion {
  id String @id @default(uuid())
  documentId String
  version Int
  data Json
  createdAt DateTime @default(now())
  createdBy String @db.VarChar(255)
  @@unique([documentId, version])
  @@index([documentId])
  @@map("posts_version")
}

model Comments {
  id String @id @default(uuid())
  content String @db.Text
  authorName String? @db.VarChar(255)
  authorEmail String? @db.VarChar(255)
  authorId String? @db.VarChar(100)
  contentType String @db.VarChar(100)
  contentId String @db.VarChar(255)
  parentId String? @db.VarChar(255)
  status String @db.VarChar(100) @default("pending")
  author Users? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("comments")
}

model ContactMessages {
  id String @id @default(uuid())
  name String @db.VarChar(255)
  email String @db.VarChar(255)
  phone String? @db.VarChar(255)
  company String? @db.VarChar(255)
  subject String @db.VarChar(255)
  message String @db.Text
  status String @db.VarChar(100) @default("new")
  assignedToId String? @db.VarChar(100)
  notes String? @db.Text
  sourcePage String? @db.VarChar(255)
  locale String? @db.VarChar(255)
  submittedAt DateTime?
  assignedTo Users? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("contact_messages")
}

model Countries {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name String @db.VarChar(255)
  code String? @db.VarChar(255)
  flag String? @db.VarChar(255)
  color String @db.VarChar(255) @default("#FF6B35")
  description String? @db.Text
  backgroundImageId String? @db.VarChar(255)
  offices Json?
  order Int @default(0)
  backgroundImage Media? @relation(fields: [backgroundImageId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("countries")
}

model Jobs {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  title String @db.VarChar(255)
  location String @db.VarChar(255)
  flag String? @db.VarChar(255)
  employmentType String @db.VarChar(100) @default("Full-time")
  salary String @db.VarChar(255) @default("Competitive")
  description String @db.Text
  requirements Json?
  applyLabel String @db.VarChar(255) @default("Apply Now")
  applyLink String? @db.VarChar(255)
  order Int @default(0)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("jobs")
}

model Settings {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  siteName String @db.VarChar(255) @default("AGBON")
  siteDescription Json?
  logo Json?
  contact Json?
  headerNavigation Json?
  footer Json?
  socialMedia Json?
  newsletter Json?
  legal Json?
  seo Json?
  features Json?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("settings")
}

model ProductCategories {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name Json
  slug String @db.VarChar(255) @unique
  description Json?
  imageId String? @db.VarChar(255)
  icon String? @db.VarChar(255)
  parentCategoryId String? @db.VarChar(255)
  order Int @default(0)
  image Media? @relation(fields: [imageId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  products Products[]
  @@index([status])
  @@map("product_categories")
}

model Products {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name Json
  model Json?
  slug String @db.VarChar(255) @unique
  description Json?
  shortDescription Json?
  categoryId String? @db.VarChar(100)
  media Json?
  specifications Json?
  inStock Boolean @default(true)
  featured Boolean @default(false)
  order Int @default(0)
  instructions Json?
  category ProductCategories? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("products")
}

