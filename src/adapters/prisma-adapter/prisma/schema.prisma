generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Users {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  email String @db.VarChar(255) @unique
  role String @db.VarChar(100) @default("user")
  name String? @db.VarChar(255)
  active Boolean @default(true)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("users")
}

model Roles {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name String @db.VarChar(255) @unique
  displayName String @db.VarChar(255)
  description String? @db.VarChar(255)
  permissions Json
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("roles")
}

model Permissions {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  name String @db.VarChar(255) @unique
  resource String @db.VarChar(100)
  action String @db.VarChar(100)
  description String? @db.VarChar(255)
  metadata Json?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("permissions")
}

model Media {
  id String @id @default(uuid())
  documentId String
  status String @db.VarChar(20)
  filename String @db.VarChar(255)
  mimeType String @db.VarChar(255)
  url String @db.VarChar(255)
  width Int?
  height Int?
  filesize Int
  alt String? @db.VarChar(255)
  caption String? @db.VarChar(255)
  metadata Json?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@unique([documentId, status])
  @@index([documentId])
  @@map("media")
}

model MediaVersion {
  id String @id @default(uuid())
  documentId String
  version Int
  data Json
  createdAt DateTime @default(now())
  createdBy String @db.VarChar(255)
  @@unique([documentId, version])
  @@index([documentId])
  @@map("media_version")
}

model Pages {
  id String @id @default(uuid())
  documentId String
  status String @db.VarChar(20)
  title String @db.VarChar(255)
  slug String @db.VarChar(255) @unique
  excerpt String? @db.Text
  content Json?
  status String @db.VarChar(100) @default("draft")
  seo Json?
  featuredImage String? @db.VarChar(255)
  featuredImage Media @relation("featuredImage", fields: [featuredImage], references: [id], onDelete: SetNull)
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@unique([documentId, status])
  @@index([documentId])
  @@map("pages")
}

model PagesVersion {
  id String @id @default(uuid())
  documentId String
  version Int
  data Json
  createdAt DateTime @default(now())
  createdBy String @db.VarChar(255)
  @@unique([documentId, version])
  @@index([documentId])
  @@map("pages_version")
}

model Settings {
  id String @id @default(uuid())
  status String @db.VarChar(20)
  siteName String @db.VarChar(255) @default("AGBON")
  logo Json?
  contact Json?
  headerNavigation Json?
  footer Json?
  socialMedia Json?
  newsletter Json?
  legal Json?
  features Json?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String? @db.VarChar(255)
  @@index([status])
  @@map("settings")
}

