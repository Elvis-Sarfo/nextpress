# Database
DATABASE_URL="postgresql://user:password@localhost:5432/nextpress?schema=public"
DATABASE_URI="postgresql://user:password@localhost:5432/nextpress?schema=public"

# Auth
AUTH_SECRET="your-auth-secret-here"

# Seed (optional override for default admin password)
ADMIN_PASSWORD="Admin1234!"

# Preview
PREVIEW_SECRET="your-preview-secret-here"

# Public URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Storage Provider: local | s3 | supabase | cloudinary
NEXTPRESS_STORAGE_PROVIDER="local"

# Local storage
NEXTPRESS_LOCAL_UPLOAD_DIR="public/uploads/media"
NEXTPRESS_LOCAL_PUBLIC_PATH="/uploads/media"

# AWS S3 storage
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""

# Supabase storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# Cloudinary storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="nextpress-media"
