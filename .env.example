# Database
DATABASE_URL="mysql://user:password@localhost:3306/nextpress"
DATABASE_URI="mysql://user:password@localhost:3306/nextpress"
PRISMA_DB_PROVIDER="mysql"

# Auth
AUTH_SECRET="your-auth-secret-here"

# Seed (optional override for default admin password)
ADMIN_PASSWORD="Admin1234!"

# Preview
PREVIEW_SECRET="your-preview-secret-here"

# Public URL
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Contact message notifications
ADMIN_NOTIFICATION_EMAILS=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_EMAIL=""
SMTP_FROM_NAME="NextPress"

# Storage Provider: local | s3 | supabase | cloudinary
NEXTPRESS_STORAGE_PROVIDER="local"

# Local storage
NEXTPRESS_LOCAL_UPLOAD_DIR="public/uploads/media"
NEXTPRESS_LOCAL_PUBLIC_PATH="/uploads/media"

# AWS S3 storage
S3_BUCKET=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_PUBLIC_BASE_URL=""

# Supabase storage
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="media"

# Cloudinary storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="nextpress-media"
