generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// PAGE - Hierarchical content (like WordPress pages)
// ============================================================================

model Page {
  id            String    @id @default(uuid())
  documentId    String    // Links draft/published versions
  status        String    @db.VarChar(20) // DRAFT, PUBLISHED, SCHEDULED, ARCHIVED
  parentId      String?   // Hierarchy
  order         Int       @default(0)
  template      String?   @db.VarChar(100)
  metadata      Json?     // Custom fields, SEO, etc.
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String    @db.VarChar(255)

  parent    Page?         @relation("PageHierarchy", fields: [parentId], references: [id])
  children  Page[]        @relation("PageHierarchy")
  locales   PageLocale[]
  comments  Comment[]
  menuItems MenuItem[]
  // Note: versions are queried via documentId, not a direct relation

  @@unique([documentId, status])
  @@index([status])
  @@index([parentId])
  @@index([documentId])
  @@map("page")
}

model PageLocale {
  id      String  @id @default(uuid())
  pageId  String
  locale  String  @db.VarChar(10)
  title   String  @db.VarChar(500)
  slug    String  @db.VarChar(255)
  content String  @db.Text
  excerpt String? @db.Text

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, locale])
  @@unique([locale, slug])
  @@index([locale])
  @@map("page_locale")
}

model PageVersion {
  id         String   @id @default(uuid())
  documentId String
  version    Int
  data       Json     // Full snapshot
  createdAt  DateTime @default(now())
  createdBy  String   @db.VarChar(255)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("page_version")
}

// ============================================================================
// POST - Blog posts (like WordPress posts)
// ============================================================================

model Post {
  id            String    @id @default(uuid())
  documentId    String
  status        String    @db.VarChar(20)
  featuredImage String?   @db.VarChar(500)
  metadata      Json?
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String    @db.VarChar(255)

  locales  PostLocale[]
  comments Comment[]
  // Note: versions are queried via documentId, not a direct relation

  @@unique([documentId, status])
  @@index([status])
  @@index([documentId])
  @@index([publishedAt(sort: Desc)])
  @@map("post")
}

model PostLocale {
  id      String  @id @default(uuid())
  postId  String
  locale  String  @db.VarChar(10)
  title   String  @db.VarChar(500)
  slug    String  @db.VarChar(255)
  content String  @db.Text
  excerpt String? @db.Text

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, locale])
  @@unique([locale, slug])
  @@index([locale])
  @@map("post_locale")
}

model PostVersion {
  id         String   @id @default(uuid())
  documentId String
  version    Int
  data       Json
  createdAt  DateTime @default(now())
  createdBy  String   @db.VarChar(255)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("post_version")
}

// ============================================================================
// NEWS - News articles (date-focused content)
// ============================================================================

model News {
  id            String    @id @default(uuid())
  documentId    String
  status        String    @db.VarChar(20)
  category      String?   @db.VarChar(100)
  featuredImage String?   @db.VarChar(500)
  metadata      Json?
  publishedAt   DateTime?
  scheduledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String    @db.VarChar(255)

  locales  NewsLocale[]
  comments Comment[]
  // Note: versions are queried via documentId, not a direct relation

  @@unique([documentId, status])
  @@index([status])
  @@index([documentId])
  @@index([category])
  @@index([publishedAt(sort: Desc)])
  @@map("news")
}

model NewsLocale {
  id      String  @id @default(uuid())
  newsId  String
  locale  String  @db.VarChar(10)
  title   String  @db.VarChar(500)
  slug    String  @db.VarChar(255)
  content String  @db.Text
  excerpt String? @db.Text

  news News @relation(fields: [newsId], references: [id], onDelete: Cascade)

  @@unique([newsId, locale])
  @@unique([locale, slug])
  @@index([locale])
  @@map("news_locale")
}

model NewsVersion {
  id         String   @id @default(uuid())
  documentId String
  version    Int
  data       Json
  createdAt  DateTime @default(now())
  createdBy  String   @db.VarChar(255)

  @@unique([documentId, version])
  @@index([documentId])
  @@map("news_version")
}

// ============================================================================
// MENU & MENU ITEMS
// ============================================================================

model Menu {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  displayName String   @db.VarChar(255)
  location    String?  @db.VarChar(100) // header, footer, sidebar
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String   @db.VarChar(255)

  items MenuItem[]

  @@map("menu")
}

model MenuItem {
  id        String   @id @default(uuid())
  menuId    String
  parentId  String?
  order     Int      @default(0)
  label     Json     // { "en": "About", "fr": "À propos" }
  url       String?  @db.VarChar(500)
  pageId    String?  // Link to Page
  postId    String?  // Link to Post
  newsId    String?  // Link to News
  target    String   @default("_self") @db.VarChar(20)
  cssClass  String?  @db.VarChar(100)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemHierarchy", fields: [parentId], references: [id])
  children MenuItem[] @relation("MenuItemHierarchy")
  page     Page?      @relation(fields: [pageId], references: [id], onDelete: SetNull)

  @@index([menuId])
  @@index([parentId])
  @@index([menuId, order])
  @@map("menu_item")
}

// ============================================================================
// LINK COLLECTIONS
// ============================================================================

model LinkCollection {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  displayName String   @db.VarChar(255)
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String   @db.VarChar(255)

  links Link[]

  @@map("link_collection")
}

model Link {
  id           String   @id @default(uuid())
  collectionId String
  order        Int      @default(0)
  title        Json     // Localized
  description  Json?    // Localized
  url          String   @db.VarChar(500)
  imageUrl     String?  @db.VarChar(500)
  target       String   @default("_self") @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  collection LinkCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@index([collectionId])
  @@index([collectionId, order])
  @@map("link")
}

// ============================================================================
// COMMENTS (polymorphic - can attach to Page, Post, or News)
// ============================================================================

model Comment {
  id          String    @id @default(uuid())
  // Polymorphic reference
  pageId      String?
  postId      String?
  newsId      String?
  // Threading
  parentId    String?
  // Author info
  authorName  String    @db.VarChar(255)
  authorEmail String    @db.VarChar(255)
  authorUrl   String?   @db.VarChar(500)
  authorIp    String?   @db.VarChar(45)
  // Content
  content     String    @db.Text
  status      String    @default("pending") @db.VarChar(20)
  // Moderation
  moderatedBy String?   @db.VarChar(255)
  moderatedAt DateTime?
  userAgent   String?   @db.VarChar(500)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  page    Page?     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  post    Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  news    News?     @relation(fields: [newsId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")

  @@index([pageId])
  @@index([postId])
  @@index([newsId])
  @@index([parentId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("comment")
}

// ============================================================================
// SLUG REDIRECTS (for URL preservation when slugs change)
// ============================================================================

model SlugRedirect {
  id           String   @id @default(uuid())
  contentType  String   @db.VarChar(20) // 'page', 'post', 'news'
  locale       String   @db.VarChar(10)
  fromSlug     String   @db.VarChar(255)
  toDocumentId String   // documentId of target
  createdAt    DateTime @default(now())

  @@unique([contentType, locale, fromSlug])
  @@index([toDocumentId])
  @@map("slug_redirect")
}

// ============================================================================
// RBAC - ROLES
// ============================================================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique @db.VarChar(100)
  displayName String   @db.VarChar(255)
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users UserRole[]

  @@map("role")
}

// ============================================================================
// RBAC - USER ROLE ASSIGNMENT
// ============================================================================

model UserRole {
  userId     String   @db.VarChar(255)
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String   @db.VarChar(255)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_role")
}
